SECRET_KEY=your-random-secret-key-here
# Set to "true" ONLY once a TLS reverse proxy (nginx/Caddy) is in front of this
# app. Over plain HTTP, browsers silently refuse to store/send a Secure
# cookie, which makes login appear to succeed but immediately bounce back
# to the login page.
SESSION_COOKIE_SECURE=false
GOOGLE_CREDENTIALS_PATH=google_credentials.json
USERS_SHEET_ID=
ALLOWED_DOMAINS=almaly.kz
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=kanban
POSTGRES_USER=kanban
POSTGRES_PASSWORD=
